# ============================================================
# GrainProfiler v1.0 — .gitignore
# ============================================================

# --- Large binaries ---
# MKProfiler.exe exceeds GitHub's 100 MB per-file limit, so it is
# tracked via Git LFS instead — see .gitattributes.
grainprofiler_prev.exe
grainprofiler_before_mkprofiler_*.exe
MKProfiler_before_weightfix_*.exe
MKProfiler_Windows_*.zip
MKProfiler_Windows_*.sha256.txt

# --- Test / input data (raw images are NOT committed) ---
test_image_data/

# --- Incidental notebook QC artifacts ---
pipeline/notebooks/ocr_ssocr_qc/

# --- Local machine overrides (created by the user) ---
pipeline/env.local.yaml

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.ipynb_checkpoints/
.mypy_cache/
.pytest_cache/

# --- R ---
.Rhistory
.RData
.Ruserdata
.Rproj.user/
*.Rproj

# --- OS / editor ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
